# Copy this file to terraform.tfvars and fill in real values.
# Do NOT commit terraform.tfvars — it is git-ignored.


environment           = "dev"
bedrock_agent_zip_path = "../multi-agent-registration-app/bedrock-agent/dist/bedrock_agent.zip"
email_worker_zip_path  = "../multi-agent-registration-app/agent-worker-email/dist/agent_worker_email.zip"

# Bedrock AgentCore agent IDs and alias IDs.
# Find these in the AWS Console under Amazon Bedrock > Agents.
bedrock_validator_agent_id           = "OYHMDXIYFX"
bedrock_validator_agent_alias_id     = "CHANGE_ME"
bedrock_error_handler_agent_id       = "CHANGE_ME"
bedrock_error_handler_agent_alias_id = "CHANGE_ME"
bedrock_handoff_agent_id             = "CHANGE_ME"
bedrock_handoff_agent_alias_id       = "CHANGE_ME"

# Optional — tune throttling for your expected load
api_gateway_throttle_burst = 50
api_gateway_throttle_rate  = 100

# Required for agent-worker-email Lambda
# Must be a verified SES sender email in your AWS account
ses_sender_email = "CHANGE_ME"
